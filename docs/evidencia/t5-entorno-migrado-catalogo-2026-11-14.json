    "checks_embolsado": [
      {
        "nombre": "chk_evento_lote_vivero_embolsado_consistente",
        "validada": true,
        "definicion": "CHECK (((tipo_evento <> 'EMBOLSADO'::tipo_evento_vivero) OR ((saldo_vivo_antes = 0) AND (cantidad_afectada IS NOT NULL) AND (cantidad_afectada = (saldo_vivo_despues)::numeric))))"
      },
      {
        "nombre": "chk_evento_lote_vivero_saldos_eventos_vivos_requeridos",
        "validada": true,
        "definicion": "CHECK ((((tipo_evento = 'EMBOLSADO'::tipo_evento_vivero) AND (saldo_vivo_antes IS NULL) AND (saldo_vivo_despues IS NOT NULL) AND (saldo_vivo_despues >= 0)) OR ((tipo_evento = ANY (ARRAY['MERMA'::tipo_evento_vivero, 'DESPACHO'::tipo_evento_vivero])) AND (saldo_vivo_antes IS NOT NULL) AND (saldo_vivo_despues IS NOT NULL) AND (saldo_vivo_antes >= 0) AND (saldo_vivo_despues >= 0)) OR (tipo_evento <> ALL (ARRAY['EMBOLSADO'::tipo_evento_vivero, 'MERMA'::tipo_evento_vivero, 'DESPACHO'::tipo_evento_vivero]))))"
      }
    ]
