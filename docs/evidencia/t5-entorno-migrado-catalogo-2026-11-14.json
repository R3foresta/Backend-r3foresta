      "definicion": "CREATE UNIQUE INDEX evento_lote_base_viva_unica_t5 ON public.evento_lote_vivero USING btree (lote_id) WHERE (tipo_evento = ANY (ARRAY['EMBOLSADO'::tipo_evento_vivero, 'INCORPORACION'::tipo_evento_vivero]))"
