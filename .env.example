# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Cliente público para proyecciones permitidas; no sustituye al cliente privado.
SUPABASE_KEY=<supabase-key-usada-por-el-backend>

# Requerida por verificación de identidad, datos privados y RPC operativas.
# Nunca exponerla al frontend; getAdminClient() no tiene fallback al público.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Autenticación
# Obligatorio en todos los entornos; secreto largo y aleatorio. No hay fallback.
JWT_SECRET=<jwt-secret>

# Pinata / IPFS
PINATA_JWT=<pinata-jwt>
GATEWAY_URL=<gateway>.mypinata.cloud

# Blockchain
RPC_URL=https://<rpc-endpoint>
PRIVATE_KEY=<private-key-de-la-wallet-firmante>
CONTRACT_ADDRESS=0x<contract-address>

# HTTP
PORT=3000
# Opcional: restringir el servidor de desarrollo al equipo local.
# HOST=127.0.0.1

# Orígenes adicionales separados por coma.
# CORS_ORIGINS=https://app.ejemplo.com,https://admin.ejemplo.com

# Vista de lectura territorial opcional.
# UBICACION_VIEW_NAME=v_ubicacion_enriquecida

# Cargas participantes: habilitar el worker de expiración y compensación de Storage.
# Pendientes duran 30 días; ledger, claves y tombstones se conservan aunque esté apagado.
# Requiere migraciones 074–076 y bucket privado cotejados. Deshabilitado en tests.
PARTICIPACION_CARGAS_CLEANUP_ENABLED=false
